<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neuro.cns.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/bwtan/Desktop/Interview2026/neuro_cns_explorer/refresh_data.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/bwtan/Desktop/Interview2026/neuro_cns_explorer</string>

    <!-- Run on the 1st of every month at 03:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bwtan/Desktop/Interview2026/neuro_cns_explorer/data/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bwtan/Desktop/Interview2026/neuro_cns_explorer/data/refresh.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
